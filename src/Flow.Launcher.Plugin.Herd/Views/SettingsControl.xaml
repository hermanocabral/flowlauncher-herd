<UserControl x:Class="Flow.Launcher.Plugin.Herd.Views.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Flow.Launcher.Plugin.Herd.Models"
             xmlns:views="clr-namespace:Flow.Launcher.Plugin.Herd.Views"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="540" d:DesignWidth="820">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <views:EnumToBooleanConverter x:Key="EnumBool" />
        <views:CountToVisibilityConverter x:Key="EmptyToVis" />
        <views:GroupIconConverter x:Key="GroupIcon" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,10,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: group list -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="App groups" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="＋ New group" Click="AddGroup_Click" HorizontalContentAlignment="Center" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Duplicate" Click="DuplicateGroup_Click" />
                    <Button Content="Delete" Click="DeleteGroup_Click" />
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="GroupsList"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AppGroup}">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                    Background="#22808080" Margin="0,0,9,0">
                                <Image Width="22" Height="22" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource GroupIcon}">
                                            <Binding Path="IconPath" />
                                            <Binding Path="Apps.Count" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="Gray" FontSize="11"
                                           Text="{Binding Apps.Count, StringFormat={}{0} apps}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: detail -->
        <Grid Grid.Column="1">
            <TextBlock Text="Select a group on the left, or add one to get started."
                       Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedGroup}">

                    <!-- Name + description -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Icon (compact, secondary) -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Icon" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" Foreground="Gray" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                   Text="{Binding IconPath, TargetNullValue=Default sheep icon, FallbackValue=Default sheep icon}" />
                        <Button Content="Change…" Click="BrowseIcon_Click" Margin="10,0,6,0" />
                        <Button Content="Use default" Click="ClearIcon_Click" Margin="0" />
                    </StackPanel>

                    <!-- Launch mode -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Launch" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <RadioButton GroupName="LaunchMode" Content="All at once" VerticalAlignment="Center" Margin="0,0,16,0"
                                     IsChecked="{Binding LaunchMode, Converter={StaticResource EnumBool}, ConverterParameter=Parallel}" />
                        <RadioButton x:Name="OneByOneRadio" GroupName="LaunchMode" Content="One by one" VerticalAlignment="Center"
                                     IsChecked="{Binding LaunchMode, Converter={StaticResource EnumBool}, ConverterParameter=Sequential}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                                    Visibility="{Binding IsChecked, ElementName=OneByOneRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="wait" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,6,0" />
                            <TextBox Width="64" Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ms between" VerticalAlignment="Center" Foreground="Gray" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Apps header -->
                    <Grid Margin="0,18,0,6">
                        <TextBlock Text="Apps" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Content="＋ Add app  ▾" Click="AddApp_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="File…" Click="AddFile_Click" />
                                    <MenuItem Header="Folder…" Click="AddFolder_Click" />
                                    <MenuItem Header="Web link" Click="AddUrl_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Empty state -->
                    <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="16"
                            Visibility="{Binding Apps.Count, Converter={StaticResource EmptyToVis}}">
                        <TextBlock Foreground="Gray" HorizontalAlignment="Center"
                                   Text="No apps yet — click ＋ Add app to add one." />
                    </Border>

                    <!-- App list: one expandable card per app -->
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AppEntry}">
                                <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="6,0,2,0"
                                                  IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Enable or disable this app without removing it" />

                                        <Expander Grid.Column="1" Padding="0,2">
                                            <Expander.Header>
                                                <StackPanel Margin="2,0">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="460" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Expander.Header>

                                            <StackPanel Margin="6,8,6,6">
                                                <TextBlock Text="Name (optional)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="Target — app, file, folder, or URL" Style="{StaticResource FieldLabel}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseTarget_Click" />
                                                </Grid>

                                                <TextBlock Text="Arguments (optional)" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="Working directory (optional)" Style="{StaticResource FieldLabel}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseWorkingDir_Click" />
                                                </Grid>
                                                <TextBlock Text="Leave empty to use the app's own folder." Foreground="Gray" FontSize="11" Margin="0,3,0,0" />

                                                <CheckBox Content="Run as administrator" Margin="0,10,0,0"
                                                          IsChecked="{Binding RunAsAdmin, UpdateSourceTrigger=PropertyChanged}" />

                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Button Content="Move up" Click="MoveUp_Click" />
                                                    <Button Content="Move down" Click="MoveDown_Click" />
                                                    <Button Content="Remove" Click="RemoveApp_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
