<UserControl x:Class="Flow.Launcher.Plugin.Herd.Views.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:Flow.Launcher.Plugin.Herd.Models"
             xmlns:views="clr-namespace:Flow.Launcher.Plugin.Herd.Views"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="520" d:DesignWidth="780">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <ObjectDataProvider x:Key="LaunchModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:LaunchMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: group list -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="App groups" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add" Click="AddGroup_Click" />
                <Button Content="Duplicate" Click="DuplicateGroup_Click" />
                <Button Content="Delete" Click="DeleteGroup_Click" />
            </StackPanel>
            <ListBox x:Name="GroupsList"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     DisplayMemberPath="Name" />
        </DockPanel>

        <!-- Right: detail -->
        <Grid Grid.Column="1">
            <TextBlock Text="Select a group on the left, or add one to get started."
                       Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedGroup}">

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Custom icon (optional)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseIcon_Click" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Launch mode" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" Width="130"
                                  ItemsSource="{Binding Source={StaticResource LaunchModeValues}}"
                                  SelectedItem="{Binding LaunchMode}" />
                        <TextBlock Grid.Column="2" Text="Delay (ms)" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,8,0" />
                        <TextBox Grid.Column="3" Width="80" Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="Applications" Style="{StaticResource FieldLabel}" Margin="0,14,0,2" FontSize="14" />
                    <TextBlock Text="Enter launches every enabled app. Working directory defaults to the app's folder."
                               Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <DataGrid x:Name="AppsGrid" ItemsSource="{Binding Apps}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MinHeight="160" MaxHeight="280"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                            <DataGridTextColumn Header="Target (path / URL / folder)" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Working dir" Binding="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding RunAsAdmin, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Add file…" Click="AddFile_Click" />
                        <Button Content="Add folder…" Click="AddFolder_Click" />
                        <Button Content="Add URL" Click="AddUrl_Click" />
                        <Button Content="Set working dir…" Click="SetWorkingDir_Click" />
                        <Button Content="Move up" Click="MoveUp_Click" />
                        <Button Content="Move down" Click="MoveDown_Click" />
                        <Button Content="Remove" Click="RemoveApp_Click" />
                    </WrapPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
